{
  "name": "tickethub-platform",
  "version": "1.0.0",
  "description": "TicketHub - Event Booking and Ticketing System (TOR FR-01 to FR-49)",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node src/store/seed-cli.js",
    "test": "node --test --test-concurrency=1 tests/unit/models.unit.test.js tests/unit/other-classes.unit.test.js tests/integration/api-e2e.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage tests/unit/models.unit.test.js",
    "test:profile": "node tests/profiling/run-profiling.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.11",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.3"
  }
}
